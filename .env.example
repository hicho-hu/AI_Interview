ENVIRONMENT=development
DATABASE_URL=mysql+pymysql://interview:interview-local@127.0.0.1:3306/interview?charset=utf8mb4
# RDS 部署时替换账号、密码和库名；密码中的特殊字符须 URL 编码。
# DATABASE_URL=mysql+pymysql://<RDS_USER>:<URL_ENCODED_PASSWORD>@rm-bp1oy236xwaqsr7x91o.mysql.rds.aliyuncs.com:3306/AI_Interview?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
# 阿里云 Redis 外网连接（本地开发）；密码须 URL 编码，勿在仓库中保存真实凭证。
# REDIS_URL=redis://r-bp1fo2l5334yvy1mey:<URL_ENCODED_PASSWORD>@r-bp1fo2l5334yvy1meypd.redis.rds.aliyuncs.com:6379/0
# 同 VPC 部署时使用内网地址。
# REDIS_URL=redis://r-bp1fo2l5334yvy1mey:<URL_ENCODED_PASSWORD>@r-bp1fo2l5334yvy1mey.redis.rds.aliyuncs.com:6379/0
TASK_MODE=worker
# 异步任务默认由 API 内置执行器兜底，所有环境一致；独立 Celery Worker/Beat 可选。
TASK_FALLBACK_ENABLED=true
TASK_POLL_SECONDS=1
# 关闭 Redis 故障兜底时设为 true；默认临时使用本进程缓存和限流。
REDIS_REQUIRED=false
# 开发初期功能开关，所有环境一致。模拟购买会发放权益，不会产生真实扣款。
MOCK_PAYMENT_ENABLED=true
DEV_LOGIN_ENABLED=true
# 已启用 MFA 的账号仍需动态验证码；此项只控制是否强制所有管理员启用。
ADMIN_MFA_REQUIRED=false
STORAGE_BACKEND=local
STORAGE_PATH=var/objects
# 阿里云 OSS：长期密钥只允许放在后端 .env，角色必须具有 Bucket 的对象权限。
# STORAGE_BACKEND=oss
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_RAM_ROLE_ARN=
OSS_BUCKET_NAME=ai-interview-storage
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou
OSS_STS_ENDPOINT=sts.cn-hangzhou.aliyuncs.com
OSS_STS_DURATION_SECONDS=3600
# 系统 PATH 中的 FFmpeg/FFprobe；本机独立安装时可改为可执行文件的绝对路径。
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# 生成本地文件访问链接的对外 API 根地址；允许 HTTP/HTTPS，同源部署可留空使用相对链接。
PUBLIC_BASE_URL=http://localhost:8000
SECRET_KEY=development-only-change-this-secret-32-chars
# ENCRYPTION_KEY=<Fernet key; 不设置时从 SECRET_KEY 派生，已有数据必须沿用旧密钥>
INITIAL_CREDITS=3
PROVIDER_MODE=mock
# PROVIDER_URL=https://your-private-ai-gateway.example.com
# PROVIDER_API_KEY=
# PROVIDER_MODEL=
# Qwen 北京业务空间：启用以下配置，并在环境或本地 .env 中设置 DASHSCOPE_API_KEY。
# PROVIDER_MODE=compatible
# PROVIDER_URL=https://ws-lds0gazpv5zfs7j1.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# PROVIDER_MODEL=qwen3.8-omni-flash
# ASR_PROVIDER=qwen
# ASR_MODEL=qwen3-asr-flash
# DASHSCOPE_API_KEY=
# TTS_PROVIDER=dashscope
# DASHSCOPE_WEBSOCKET_URL=wss://ws-lds0gazpv5zfs7j1.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
# TTS_MODEL=qwen-audio-3.1-tts-flash
# TTS_VOICE=longanhuan_v3.1
# LLM_INPUT_COST_PER_MILLION=0
# LLM_OUTPUT_COST_PER_MILLION=0
# TTS_INPUT_COST_PER_MILLION=0
# TTS_OUTPUT_COST_PER_MILLION=0
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# S3_ENDPOINT_URL=http://localhost:9000
# S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=ai-interview
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# ADMIN_USER_IDS=<comma-separated user UUIDs>

# Qwen 实时转写：复用服务端 Provider Key；不发送密钥到浏览器。
REALTIME_ASR_ENABLED=true
REALTIME_ASR_MODEL=qwen3-asr-flash-realtime
# 可留空，根据已有 DashScope WebSocket / Compatible 地址推导同地域地址。
REALTIME_ASR_URL=

# preview 在所有环境返回测试验证码，不发送真实邮件；disabled 关闭邮件；smtp 发送真实邮件。
MAIL_MODE=preview
# 生产环境临时测试注册：MAIL_MODE=disabled + REGISTRATION_EMAIL_MOCK_ENABLED=true。
# 只模拟注册邮件，接口/页面展示随机验证码；找回密码和换绑邮箱不受此开关影响。
# 恢复真实注册时改为 false 并配置 MAIL_MODE=smtp。
REGISTRATION_EMAIL_MOCK_ENABLED=false
# 生成邀请和推广链接的前端根地址；允许 HTTP/HTTPS，同源部署可留空使用相对链接。
WEB_BASE_URL=http://127.0.0.1:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
SMTP_STARTTLS=true
